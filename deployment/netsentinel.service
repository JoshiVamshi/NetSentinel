[Unit]
Description=NetSentinel Intrusion Detection System
After=network.target

[Service]
Type=simple
User=netsentinel
Group=netsentinel
WorkingDirectory=/opt/netsentinel
ExecStart=/usr/bin/python3 /opt/netsentinel/main.py
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/netsentinel/logs /opt/netsentinel/netsentinel.db

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netsentinel

# Resource limits
LimitNOFILE=65536
MemoryLimit=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
